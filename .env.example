# Target Website URL to record
TARGET_URL=https://example.com

# Viewport dimensions (Instagram Reels / Stories 9:16 vertical ratio)
VIEWPORT_WIDTH=1080
VIEWPORT_HEIGHT=1920

# Duration of video / scroll speed in seconds
RECORD_DURATION=10

# Wait time in milliseconds after page load before recording starts
INITIAL_WAIT=2000

# Video Frames Per Second
FPS=30

# Output folder for .mp4 video files
OUTPUT_DIR=./output

# High-DPI screen emulation scale factor
DEVICE_SCALE_FACTOR=2

# Mobile User-Agent string
USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.6 Mobile/15E148 Safari/604.1
